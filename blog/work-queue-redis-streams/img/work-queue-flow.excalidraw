    {
      "type": "text",
      "id": "t-evid",
      "x": 80,
      "y": 490,
      "width": 460,
      "height": 146,
      "text": "# hot path \u2014 a blocking read\nXREADGROUP GROUP jobs-group worker-1\n  COUNT 1 BLOCK 1000\n  STREAMS jobs.imageProcessing.v1 >\n\n# catch-up \u2014 claim the idle, route the dead\nFCALL read_claim_or_dlq 2\n  jobs.imageProcessing.v1 ...:dlq\n  jobs-group worker-1 5000 1 2",
      "originalText": "# hot path \u2014 a blocking read\nXREADGROUP GROUP jobs-group worker-1\n  COUNT 1 BLOCK 1000\n  STREAMS jobs.imageProcessing.v1 >\n\n# catch-up \u2014 claim the idle, route the dead\nFCALL read_claim_or_dlq 2\n  jobs.imageProcessing.v1 ...:dlq\n  jobs-group worker-1 5000 1 2",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#FFFFFF",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
