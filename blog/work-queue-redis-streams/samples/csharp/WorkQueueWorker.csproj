<!-- Minimal runner for the Work Queue blog-post sample. Run: dotnet run, then the consumer name -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>WorkQueueWorker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NRedisStack brings StackExchange.Redis (db.Execute) in transitively -->
    <PackageReference Include="NRedisStack" Version="1.7.3" />
  </ItemGroup>

</Project>
